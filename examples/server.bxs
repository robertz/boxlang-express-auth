/**
 * Runnable login demo for GitHub, Google, Microsoft and/or GitLab —
 * whichever has credentials.
 *
 *   export GITHUB_CLIENT_ID=...     GITHUB_CLIENT_SECRET=...
 *   export GOOGLE_CLIENT_ID=...     GOOGLE_CLIENT_SECRET=...
 *   export MICROSOFT_CLIENT_ID=...  MICROSOFT_CLIENT_SECRET=...  MICROSOFT_TENANT=common
 *   export GITLAB_CLIENT_ID=...     GITLAB_CLIENT_SECRET=...     GITLAB_BASE_URL=https://gitlab.com
 *   export APPLE_SERVICES_ID=...    APPLE_TEAM_ID=...  APPLE_KEY_ID=...  APPLE_PRIVATE_KEY_PATH=/path/AuthKey.p8
 *                                   (Apple needs an https BASE_URL on a real domain, e.g. a tunnel)
 *   export BASE_URL=http://localhost:3000      # optional; must match the registered callbacks
 *   boxlang examples/server.bxs                 # from the repo root (needs boxlang_modules/)
 *
 * Callback URLs to register:  <BASE_URL>/auth/github/callback
 *                             <BASE_URL>/auth/google/callback
 *                             <BASE_URL>/auth/microsoft/callback
 *                             <BASE_URL>/auth/gitlab/callback
 *                             <BASE_URL>/auth/apple/callback
 */
baseUrl = getSystemSetting( "BASE_URL", "http://localhost:3000" )
port = val( getSystemSetting( "PORT", "3000" ) )
providerLabels = {}

// Stands in for the app's users + user_identities tables (see README).
users = createObject( "java", "java.util.concurrent.ConcurrentHashMap" ).init()

escapeHtml = ( value ) => replaceList( toString( value ), "&,<,>,"",'", "&amp;,&lt;,&gt;,&quot;,&##39;" )

auth = boxExpressAuth( {
	verify: ( identity, tokens, req ) => {
		var userId = identity.provider & ":" & identity.id
		users.put( userId, {
			id: userId,
			provider: identity.provider,
			username: identity.username,
			name: identity.name,
			email: identity.email,
			emailVerified: identity.emailVerified
		} )
		return users.get( userId )
	},
	loadUser: ( id ) => users.get( id ),
	successRedirect: "/",
	failureRedirect: "/",
	loginPath: "/"
} )
if ( len( getSystemSetting( "GITHUB_CLIENT_ID", "" ) ) ) {
	auth.provider( "github", boxExpressAuthGitHub( {
		clientId: getSystemSetting( "GITHUB_CLIENT_ID" ),
		clientSecret: getSystemSetting( "GITHUB_CLIENT_SECRET", "" ),
		callbackUrl: baseUrl & "/auth/github/callback"
	} ) )
	providerLabels.github = "GitHub"
}
if ( len( getSystemSetting( "GOOGLE_CLIENT_ID", "" ) ) ) {
	auth.provider( "google", boxExpressAuthGoogle( {
		clientId: getSystemSetting( "GOOGLE_CLIENT_ID" ),
		clientSecret: getSystemSetting( "GOOGLE_CLIENT_SECRET", "" ),
		callbackUrl: baseUrl & "/auth/google/callback"
	} ) )
	providerLabels.google = "Google"
}
if ( len( getSystemSetting( "MICROSOFT_CLIENT_ID", "" ) ) ) {
	auth.provider( "microsoft", boxExpressAuthMicrosoft( {
		clientId: getSystemSetting( "MICROSOFT_CLIENT_ID" ),
		clientSecret: getSystemSetting( "MICROSOFT_CLIENT_SECRET", "" ),
		callbackUrl: baseUrl & "/auth/microsoft/callback",
		tenant: getSystemSetting( "MICROSOFT_TENANT", "common" )
	} ) )
	providerLabels.microsoft = "Microsoft"
}
if ( len( getSystemSetting( "GITLAB_CLIENT_ID", "" ) ) ) {
	auth.provider( "gitlab", boxExpressAuthGitLab( {
		clientId: getSystemSetting( "GITLAB_CLIENT_ID" ),
		clientSecret: getSystemSetting( "GITLAB_CLIENT_SECRET", "" ),
		callbackUrl: baseUrl & "/auth/gitlab/callback",
		baseUrl: getSystemSetting( "GITLAB_BASE_URL", "https://gitlab.com" )
	} ) )
	providerLabels.gitlab = "GitLab"
}
if ( len( getSystemSetting( "APPLE_SERVICES_ID", "" ) ) ) {
	auth.provider( "apple", boxExpressAuthApple( {
		clientId: getSystemSetting( "APPLE_SERVICES_ID" ),
		teamId: getSystemSetting( "APPLE_TEAM_ID", "" ),
		keyId: getSystemSetting( "APPLE_KEY_ID", "" ),
		privateKey: fileRead( getSystemSetting( "APPLE_PRIVATE_KEY_PATH", "" ) ),
		callbackUrl: baseUrl & "/auth/apple/callback"
	} ) )
	providerLabels.apple = "Apple"
}
if ( structIsEmpty( providerLabels ) ) {
	println( "Set the client id and secret for at least one of GITHUB_, GOOGLE_, MICROSOFT_, GITLAB_ or APPLE_ first." )
	println( "Callback URLs to register: #baseUrl#/auth/<github|google|microsoft|gitlab|apple>/callback" )
	createObject( "java", "java.lang.System" ).exit( 1 )
}

app = boxExpress()
app.use( boxExpressSession( { resave: false, saveUninitialized: false } ) )
app.use( boxExpressUrlencoded() )
app.use( "/auth", auth.formPostRoutes() )   // Apple's POST callback, ahead of CSRF
app.use( boxExpressCsrf() )
app.use( "/auth", auth.routes() )

app.get( "/", auth.optional(), ( req, res ) => {
	var body = "<!doctype html><title>boxlang-express-auth demo</title><h1>boxlang-express-auth demo</h1>"
	if ( len( req.query.error ?: "" ) ) {
		body &= "<p style='color:##b00'>Login failed: #escapeHtml( req.query.error )#</p>"
	}
	if ( isNull( req.user ) ) {
		for ( var providerKey in providerLabels ) {
			body &= "<p><a href='/auth/#providerKey#?returnTo=%2Fprivate'>Sign in with #providerLabels[ providerKey ]#</a></p>"
		}
	} else {
		body &= "<p>Signed in as <strong>#escapeHtml( len( req.user.username ) ? req.user.username : req.user.name )#</strong> via #escapeHtml( req.user.provider )# (#escapeHtml( req.user.email )#"
			& ( req.user.emailVerified ? ", verified" : ", unverified" ) & ")</p>"
			& "<form method='post' action='/auth/logout'><input type='hidden' name='_csrf' value='#escapeHtml( req.csrfToken() )#'><button>Sign out</button></form>"
	}
	body &= "<p><a href='/private'>A page that needs login</a></p>"
	res.type( "text/html" ).send( body )
} )

app.get( "/private", auth.required(), ( req, res ) => {
	res.type( "text/html" ).send( "<!doctype html><p>Hello, #escapeHtml( req.user.name ?: req.user.username )#. <a href='/'>Back</a></p>" )
} )

app.listen( port, ( boundPort ) => println( "Demo on #baseUrl# (port #boundPort#)" ) )
