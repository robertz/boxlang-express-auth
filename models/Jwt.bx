/**
 * Just enough JWS to verify an OIDC ID token: split and decode a compact
 * JWT, and check an RS256/384/512 signature against an RSA JWK or an
 * ES256/384/512 signature against an EC JWK. Not a general JWT library —
 * no encryption, no HMAC, no "none", no creation.
 */
class {

	variables.RSA_ALGORITHMS = {
		"RS256": "SHA256withRSA",
		"RS384": "SHA384withRSA",
		"RS512": "SHA512withRSA"
	}
	variables.MIN_RSA_BITS = 2048
	// JWS (RFC 7518 3.4) pins each ES algorithm to one curve, and carries
	// the signature as raw R||S rather than DER — the P1363 variants read
	// that format directly.
	variables.EC_ALGORITHMS = {
		"ES256": { java: "SHA256withECDSAinP1363Format", crv: "P-256", curve: "secp256r1", bytes: 32 },
		"ES384": { java: "SHA384withECDSAinP1363Format", crv: "P-384", curve: "secp384r1", bytes: 48 },
		"ES512": { java: "SHA512withECDSAinP1363Format", crv: "P-521", curve: "secp521r1", bytes: 66 }
	}

	function init() {
		variables.decoder = createObject( "java", "java.util.Base64" ).getUrlDecoder()
		return this
	}

	function supportedAlgorithms() {
		var names = structKeyArray( variables.RSA_ALGORITHMS )
		names.append( structKeyArray( variables.EC_ALGORITHMS ), true )
		return names
	}

	/**
	 * The JWK kty an algorithm needs ("RSA", "EC"), or "" for one this
	 * class doesn't verify.
	 */
	function keyTypeFor( required string alg ) {
		if ( structKeyExists( variables.RSA_ALGORITHMS, alg ) ) {
			return "RSA"
		}
		return structKeyExists( variables.EC_ALGORITHMS, alg ) ? "EC" : ""
	}

	/**
	 * True only for a valid signature by this key under this algorithm;
	 * anything else — wrong key type, wrong curve, unknown alg — is false.
	 */
	function verify( required struct decoded, required struct jwk, required string alg ) {
		var keyType = keyTypeFor( alg )
		if ( compare( keyType, "RSA" ) == 0 ) {
			return verifyRsa( decoded, jwk, alg )
		}
		if ( compare( keyType, "EC" ) == 0 ) {
			return verifyEc( decoded, jwk, alg )
		}
		return false
	}

	/**
	 * → { header, payload, signingInput, signature (bytes) }. Throws
	 * BoxExpressAuth.InvalidToken for anything that isn't three base64url
	 * segments holding a JSON header and a JSON claims object.
	 */
	function decode( required string token ) {
		var parts = listToArray( token, ".", true )
		if ( arrayLen( parts ) != 3 ) {
			throw( type = "BoxExpressAuth.InvalidToken", message = "ID token is not a three-part JWS" )
		}
		for ( var part in parts ) {
			if ( !reFind( "^[A-Za-z0-9_-]+$", part ) ) {
				throw( type = "BoxExpressAuth.InvalidToken", message = "ID token has a segment that isn't base64url" )
			}
		}
		var header = _jsonSegment( parts[ 1 ] )
		var payload = _jsonSegment( parts[ 2 ] )
		return {
			header: header,
			payload: payload,
			signingInput: parts[ 1 ] & "." & parts[ 2 ],
			signature: variables.decoder.decode( parts[ 3 ] )
		}
	}

	/**
	 * True only for a valid signature by this key. A key that can't be
	 * built, is under 2048 bits, or an algorithm outside RS256/384/512 is
	 * false, never an error.
	 */
	function verifyRsa( required struct decoded, required struct jwk, required string alg ) {
		if ( !structKeyExists( variables.RSA_ALGORITHMS, alg ) || compare( jwk.kty ?: "", "RSA" ) != 0 ) {
			return false
		}
		try {
			var bigInteger = createObject( "java", "java.math.BigInteger" )
			var modulus = bigInteger.init( javacast( "int", 1 ), variables.decoder.decode( jwk.n ) )
			var exponent = bigInteger.init( javacast( "int", 1 ), variables.decoder.decode( jwk.e ) )
			if ( modulus.bitLength() < variables.MIN_RSA_BITS ) {
				return false
			}
			var keySpec = createObject( "java", "java.security.spec.RSAPublicKeySpec" ).init( modulus, exponent )
			var publicKey = createObject( "java", "java.security.KeyFactory" ).getInstance( "RSA" ).generatePublic( keySpec )
			var verifier = createObject( "java", "java.security.Signature" ).getInstance( variables.RSA_ALGORITHMS[ alg ] )
			verifier.initVerify( publicKey )
			verifier.update( charsetDecode( decoded.signingInput, "US-ASCII" ) )
			return verifier.verify( decoded.signature )
		} catch ( any e ) {
			return false
		}
	}

	/**
	 * True only for a valid signature by this EC key. The key's crv must be
	 * the one the algorithm names, and the signature exactly R||S at that
	 * curve's size.
	 */
	function verifyEc( required struct decoded, required struct jwk, required string alg ) {
		if ( !structKeyExists( variables.EC_ALGORITHMS, alg ) || compare( jwk.kty ?: "", "EC" ) != 0 ) {
			return false
		}
		var spec = variables.EC_ALGORITHMS[ alg ]
		if ( compare( jwk.crv ?: "", spec.crv ) != 0 || arrayLen( decoded.signature ) != spec.bytes * 2 ) {
			return false
		}
		try {
			var bigInteger = createObject( "java", "java.math.BigInteger" )
			var point = createObject( "java", "java.security.spec.ECPoint" ).init(
				bigInteger.init( javacast( "int", 1 ), variables.decoder.decode( jwk.x ) ),
				bigInteger.init( javacast( "int", 1 ), variables.decoder.decode( jwk.y ) )
			)
			var parameters = createObject( "java", "java.security.AlgorithmParameters" ).getInstance( "EC" )
			parameters.init( createObject( "java", "java.security.spec.ECGenParameterSpec" ).init( spec.curve ) )
			var curveSpec = parameters.getParameterSpec( createObject( "java", "java.lang.Class" ).forName( "java.security.spec.ECParameterSpec" ) )
			var keySpec = createObject( "java", "java.security.spec.ECPublicKeySpec" ).init( point, curveSpec )
			var publicKey = createObject( "java", "java.security.KeyFactory" ).getInstance( "EC" ).generatePublic( keySpec )
			var verifier = createObject( "java", "java.security.Signature" ).getInstance( spec.java )
			verifier.initVerify( publicKey )
			verifier.update( charsetDecode( decoded.signingInput, "US-ASCII" ) )
			return verifier.verify( decoded.signature )
		} catch ( any e ) {
			return false
		}
	}

	function _jsonSegment( required string segment ) {
		var text = ""
		try {
			text = charsetEncode( variables.decoder.decode( segment ), "UTF-8" )
		} catch ( any e ) {
			throw( type = "BoxExpressAuth.InvalidToken", message = "ID token segment doesn't decode" )
		}
		if ( !isJSON( text ) ) {
			throw( type = "BoxExpressAuth.InvalidToken", message = "ID token segment isn't JSON" )
		}
		var parsed = jsonDeserialize( text )
		if ( !isStruct( parsed ) ) {
			throw( type = "BoxExpressAuth.InvalidToken", message = "ID token segment isn't a JSON object" )
		}
		return parsed
	}

}
